# Secrets — never commit. setup.sh writes this file with mode 600.
.env
.env.*
*.key

# Local install state
brain_config.json
.venv/
.chroma/
*.log
.last_reconcile

# Rendered launchd plist (generated by setup.sh, lives in ~/Library/LaunchAgents)
launchd/*.plist

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
